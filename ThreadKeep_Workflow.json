    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nif (rows.length === 0) {\n  return [{ json: { message: \"✅ All clear! No open signals right now.\" } }];\n}\n\n// Group by type\nconst groups = {};\nrows.forEach(row => {\n  const type = row.json.Type || 'OTHER';\n  if (!groups[type]) groups[type] = [];\n  groups[type].push(row.json);\n});\n\nconst typeEmoji = {\n  TASK: '📋',\n  MEETING: '📅',\n  DECISION: '✅',\n  COMMITMENT: '🤝',\n  BLOCKER: '⚠️',\n  FYI: 'ℹ️'\n};\n\nlet message = `🧵 *ThreadKeep Status*\\n`;\nmessage += `_${rows.length} open signals_\\n\\n`;\n\nObject.keys(groups).forEach(type => {\n  const emoji = typeEmoji[type] || '•';\n  message += `${emoji} *${type}* (${groups[type].length})\\n`;\n  groups[type].forEach(row => {\n    const person = row.Person && row.Person !== 'unspecified' ? ` → ${row.Person}` : '';\n    const due = row.Deadline && row.Deadline !== 'not mentioned' ? ` | Due: ${row.Deadline}` : '';\n    message += `• ${row.Summary}${person}${due}\\n`;\n  });\n  message += '\\n';\n});\n\nmessage += `_ThreadKeep · ${new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' })} IST_`;\n\nreturn [{ json: { message: message } }];"
      },
